                    className="h-full w-full cursor-pointer rounded-md bg-[#4B55E3] px-6 py-3 text-base font-medium whitespace-nowrap text-white transition duration-300 hover:scale-[1.01] hover:bg-[#3F48C2] lg:w-fit"
                    type="submit"
