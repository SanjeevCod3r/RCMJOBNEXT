                      onChange={(e) => setSearch(e.target.value)}
                    />
                  </div>
                  {/* Location Input */}
                  <div className="relative flex h-full w-full items-center border-b border-slate-200 transition duration-300 focus-within:border-[#4B55E3] lg:border-b-0 lg:pr-4">
